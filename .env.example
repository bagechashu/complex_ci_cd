# Release Control System - Environment Configuration
# Copy this file to .env and customize values for your environment

# Environment type: development, staging, production
ENVIRONMENT=development

# Frontend configuration
FRONTEND_PORT=80

# Backend configuration
BACKEND_PORT=8080

# Database configuration
# Note: Database path in container is /data/release_control.db
# The db_data volume persists this across container restarts

# Encryption key for sensitive data
# WARNING: Change this value in production!
ENCRYPTION_KEY=your-encryption-key-change-me-in-production
