    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.0.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.53.0",
    "prettier": "^3.0.3",
    "terser": "^5.46.1",
    "typescript": "~5.2.2",
    "vite": "^5.0.7",
    "vue-tsc": "^1.8.22"
